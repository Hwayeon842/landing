          .cat-text { padding-left:0; padding-top:12px; text-align:center; margin:0 auto; }
          .cat-text, .cat-text h3, .cat-text p, .cat-text div { text-align:left !important; margin: left -6px; !important; margin-right:auto !important; }
          .cat-below-wrap { flex-direction:column; align-items:center; margin:0 auto 4px auto; }
          .cat-below { order:1; width:100%; max-width:420px; height:auto; margin:0 0 0 0; display:block; border-radius:18px !important; box-shadow:0 8px 24px rgba(0,0,0,0.18) !important; margin-left:-498px; }
